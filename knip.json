{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app/main.ts!",
        "app/dev.ts!",
        "app/modules/sdk/index.ts!",
        "app/web.tsx!",
        "app/modules/probe/index.ts!",
        "app/modules/probe/web.ts!",
        "app/modules/testing/lib/server/storage.ts!",
        "app/modules/webhook-fake/server.ts!",
        "scripts/*.{ts,mjs}!"
      ],
      "project": [
        "app/**/*.{ts,tsx}!",
        "!app/modules/*/tests/**!",
        "!app/modules/testing/**!",
        "scripts/**/*.{ts,mjs}!",
        "!scripts/tests/**!"
      ],
      "ignoreDependencies": ["@swc/core"]
    },
    "packages/e2e": {
      "entry": ["app/modules/*/server.ts!", "app/modules/cookout/lib/server/leftover-channels.ts!"],
      "project": ["app/**/*.ts!"]
    }
  }
}

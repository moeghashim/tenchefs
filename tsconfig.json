{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo",
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "allowedUnstableApis": [
          "@effect/vitest",
          "@effect/platform-node",
          "@effect/platform-node-shared/NodeSocket",
          "@effect/sql-pg",
          "effect/cli",
          "effect/http",
          "effect/crypto",
          "effect/process",
          "effect/reactivity/Reactivity",
          "effect/sql",
          "effect/FileSystem",
          "effect/Path",
          "effect/ByteSize",
          "effect/Stdio",
          "effect/testing/TestConsole"
        ],
        "keyPatterns": [
          { "target": "service", "pattern": "default", "skipLeadingPath": ["app/modules/"] },
          { "target": "custom", "pattern": "default", "skipLeadingPath": ["app/modules/"] }
        ]
      }
    ]
  },
  "include": [
    "app",
    "scripts",
    "packages/e2e/app",
    "packages/e2e/vitest.config.ts",
    "packages/e2e/playwright.config.ts",
    "packages/handler-example",
    "vitest.config.ts",
    "tsdown.config.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
